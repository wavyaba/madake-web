# ─────────────────────────────────────────────
#  Corporación Madake — Variables de entorno
#  Copia este archivo como .env.local y llena
#  los valores REALES. NUNCA subas .env.local
#  a Git.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Obtenlos en: https://app.supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Solo para scripts de migración (NUNCA expongas esto al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Correo (Resend) ───────────────────────────
# Crea cuenta gratuita en: https://resend.com
# Settings → API Keys → Create API Key
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Correo al que llegarán las notificaciones de nuevos leads
NOTIFICATION_EMAIL=contacto@corporacionmadake.com.mx
